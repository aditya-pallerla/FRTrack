{
  "name": "kolhapur-flood-response",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"tsx watch server/src/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx server/src/index.ts",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "tsx server/src/index.ts --production",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "data:rainfall": "tsx scripts/data/fetch-rainfall.ts",
    "data:osm": "tsx scripts/data/fetch-osm.ts",
    "data:elevation": "tsx scripts/data/fetch-elevation.ts",
    "data:build": "tsx scripts/data/build-network.ts",
    "data:all": "npm run data:osm && npm run data:elevation && npm run data:build && npm run data:rainfall",
    "test": "tsx server/tests/run-all.ts",
    "test:engine": "tsx server/tests/engine.test.ts",
    "test:routing": "tsx server/tests/routing.test.ts",
    "test:allocation": "tsx server/tests/allocation.test.ts",
    "eval:warnings": "tsx server/eval/eval-warnings.ts",
    "eval:route-validity": "tsx server/eval/eval-route-validity.ts",
    "replay:check": "tsx server/eval/replay-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
